generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth (NextAuth.js v5) ──────────────────────────────────

enum Plan {
  FREE
  STUDENT // paid student plan (display) — no teacher-class entitlement
  STARTER // teacher tier: up to 3 classes / 30 students per class
  PRO // teacher tier: unlimited classes + students
  SCHOOL // department/school tier: unlimited
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   @db.Text
  plan          Plan      @default(FREE)
  role          Role      @default(STUDENT)
  roleChosen    Boolean   @default(false) // has the user explicitly picked student/teacher yet
  nudgesShown   String[]  @default([])
  trialEndsAt   DateTime? // teacher-tier trial; null unless a trial is active

  // Paddle billing linkage (set by the subscription webhook). Nullable until the
  // user checks out. plan (above) is the entitlement source of truth; these tie a
  // user to their Paddle records so webhook events can find them.
  paddleCustomerId     String?   // ctm_…
  paddleSubscriptionId String?   // sub_… (the current/last subscription)
  planTier             String?   // marketing tier slug for display: student|starter|pro|advanced
  planUpdatedAt        DateTime? // last time the billing webhook changed plan

  accounts     Account[]
  sessions     Session[]
  progress     Progress[]
  examAttempts ExamAttempt[]
  exams        Exam[]
  feedbackSubmissions FeedbackSubmission[]
  bugReports   BugReport[]
  contactMessages ContactMessage[]
  customThemes CustomTheme[]
  taughtClasses    Class[]           @relation("TaughtClasses")
  classEnrollments ClassMembership[] @relation("ClassEnrollments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paddleCustomerId])
  @@index([paddleSubscriptionId])
}

model CustomTheme {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  colors    String   @db.Text // JSON-serialized CustomColors (13 hex strings)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Examples (Phase 2) ──────────────────────────────────────

model Example {
  id        String   @id @default(cuid())
  title     String
  category  String
  code      String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ── Practice Questions (Phase 3) ────────────────────────────

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Question {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  difficulty  Difficulty @default(MEDIUM)
  year           Int?
  session        String?   // "May/June" | "Oct/Nov" | "Feb/Mar"
  variant        Int?      // 1, 2, 3
  paper          String?   // legacy freeform, e.g. "P12"
  questionNumber Int?
  part           String?   // "a", "b", "(i)", "(ii)"
  marks          Int?
  topic          String?
  tags           String[] @default([])
  // Premium gating: when true (and gating is enabled), only entitled students can
  // grade/open this question — a student on a paid plan, or one enrolled in a class
  // whose teacher is on a paid teacher tier. See lib/entitlements hasPremiumAccess.
  isPremium      Boolean  @default(false)
  starterCode String?    @db.Text

  hints               String[]
  solution            String?    @db.Text
  solutionExplanation String?    @db.Text

  testCases   TestCase[]
  progress    Progress[]
  examAnswers ExamAnswer[]
  examLinks   ExamQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topic])
}

model TestCase {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  inputs         String[]
  expectedOutput String   @db.Text
  isHidden       Boolean  @default(false)
  description    String?
  sortOrder      Int      @default(0)
  initialFiles   String?  @db.Text // JSON: Record<string, string> of filename → content

  @@index([questionId])
}

// ── Progress Tracking ───────────────────────────────────────

enum ProgressStatus {
  ATTEMPTED
  SOLVED
}

model Progress {
  id         String         @id @default(cuid())
  userId     String
  questionId String
  status     ProgressStatus @default(ATTEMPTED)
  bestScore  Int            @default(0) // best passCount
  totalTests Int            @default(0)
  attempts   Int            @default(0)
  lastCode   String?        @db.Text

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId])
  @@index([questionId])
}

// ── Exam Simulation ─────────────────────────────────────────

enum ExamStatus {
  IN_PROGRESS
  COMPLETED
  TIMED_OUT
}

model ExamAttempt {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Null for legacy self-service (random) exams; set when the attempt is a
  // run of a shared Exam definition.
  examId        String?
  exam          Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)

  // Set when this attempt is a run of a class Assignment (drives the teacher dashboard).
  assignmentId  String?
  assignment    Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  topic         String?
  difficulty    Difficulty?
  questionCount Int
  timeLimitMin  Int

  status      ExamStatus @default(IN_PROGRESS)
  score       Int?
  totalTests  Int?

  startedAt   DateTime @default(now())
  completedAt DateTime?

  answers ExamAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([examId])
  @@index([assignmentId])
}

// ── Shareable Exams (instructor-authored, reusable) ─────────

model Exam {
  id           String         @id @default(cuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  title        String
  description  String?        @db.Text
  timeLimitMin Int
  shareCode    String         @unique
  isPublished  Boolean        @default(true) // link active / disabled

  questions   ExamQuestion[]
  attempts    ExamAttempt[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model ExamQuestion {
  id         String   @id @default(cuid())
  examId     String
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)

  @@unique([examId, questionId])
  @@index([examId])
}

// ── Classes (teacher tier) ──────────────────────────────────

model Class {
  id       String  @id @default(cuid())
  ownerId  String
  owner    User    @relation("TaughtClasses", fields: [ownerId], references: [id], onDelete: Cascade)
  name     String
  joinCode String  @unique
  archived Boolean @default(false)

  memberships ClassMembership[]
  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model ClassMembership {
  id      String @id @default(cuid())
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation("ClassEnrollments", fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([classId, userId]) // idempotent joins
  @@index([classId])
  @@index([userId])
}

// An Exam handed to a Class as work. Student attempts of it are ExamAttempts
// tagged with this assignmentId, which is what the teacher dashboard reads.
model Assignment {
  id      String    @id @default(cuid())
  classId String
  class   Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  examId  String
  exam    Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  dueDate DateTime?

  attempts ExamAttempt[]

  createdAt DateTime @default(now())

  @@unique([classId, examId]) // an exam is assigned to a class at most once
  @@index([classId])
  @@index([examId])
}

// ── Admin / Reporting ───────────────────────────────────────

model FeedbackSubmission {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  rating    Int
  tier      String
  tags      String[] @default([])
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  FIXED
  WONT_FIX
}

model BugReport {
  id          String    @id @default(cuid())
  userId      String?
  email       String?
  category    String    @default("bug") // bug | suggestion | other
  description String    @db.Text
  code        String?   @db.Text // attached editor code (optional / user-editable)
  output      String?   @db.Text // attached terminal output (optional / user-editable)
  pageUrl     String?
  userAgent   String?   @db.Text
  status      BugStatus @default(OPEN)
  resolvedAt  DateTime? // set when moved to FIXED / WONT_FIX
  createdAt   DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([status])
}

// General "Contact us" submissions. Stored here and triaged in the admin inbox
// (/admin/messages) rather than emailed — mirrors the BugReport lifecycle.
enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

model ContactMessage {
  id         String        @id @default(cuid())
  userId     String?
  email      String?
  name       String?
  subject    String?
  message    String        @db.Text
  status     ContactStatus @default(NEW)
  pageUrl    String?
  resolvedAt DateTime? // set when moved to RESOLVED / ARCHIVED
  createdAt  DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([status])
}

// Anonymized, sampled snapshots of code that produced a parse error we can't
// yet explain (no_viable_alternative / mismatched_input / other_parse). Used to
// find common mistake shapes and grammar gaps so error messages can improve.
// String and char literal contents + comment text are stripped before storage
// (see interpreter/sanitizeSample.ts) so no student-typed text is retained.
model ErrorSample {
  id         String   @id @default(cuid())
  category   String // error category slug (e.g. no_viable_alternative)
  errorType  String   @default("parse") // parse | runtime
  code       String   @db.Text // sanitized source (literals/comments blanked)
  rawMessage String?  @db.Text // raw ANTLR message (already free of student text)
  line       Int? // 1-based line of the first error, if known
  codeLines  Int? // total lines in the submission
  feature    String? // playground | practice | exam | docs
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model ExamAnswer {
  id            String      @id @default(cuid())
  examAttemptId String
  examAttempt   ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question    @relation(fields: [questionId], references: [id])

  code       String?  @db.Text
  passCount  Int      @default(0)
  totalTests Int      @default(0)
  graded     Boolean  @default(false)
  sortOrder  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examAttemptId, questionId])
  @@index([examAttemptId])
}

// ── Billing (Paddle pricing page) ──────────────────────────
// The tier → Paddle price-ID binding lives in the DB so catalog IDs stay out of
// code and the sandbox↔live switch is a data concern: rows are tagged by
// `paddleEnv` and the /pricing page selects the set matching NEXT_PUBLIC_PADDLE_ENV.
// Amounts/currency are NOT stored here — Paddle is the source of truth for money
// (the page shows Paddle's formattedTotals). This holds only display copy + the
// price IDs to preview and check out.
model PricingTier {
  id           String   @id @default(cuid())
  slug         String // 'starter' | 'pro' | 'advanced'
  name         String // display name
  description  String
  features     String[]
  monthPriceId String // Paddle pri_… (monthly)
  yearPriceId  String // Paddle pri_… (yearly)
  paddleEnv    String // 'sandbox' | 'production'
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  // Contact-sales tier: no self-serve checkout. The card shows a "Contact me"
  // CTA instead of a price + Subscribe, and its price IDs may be empty.
  contactOnly  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, paddleEnv])
  @@index([paddleEnv, active])
}
